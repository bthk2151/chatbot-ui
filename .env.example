# Existing Auth.js Google configuration
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
API_BASE_URL=http://localhost:8000

# Must match Tree-RAG. Use distinct values and keys for each environment.
RAG_JWT_ISSUER=chatbot-ui-local
RAG_JWT_AUDIENCE=tree-rag-local
# PKCS#8 PEM; actual multiline PEM or literal \n escapes are accepted.
# Private key only belongs on the Next.js server. Never use NEXT_PUBLIC_.
RAG_JWT_PRIVATE_KEY=
